# Скопируйте этот файл в .env и впишите свои значения. .env в git не попадает.
# Сгенерировать ключ (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToHexString($b)
# или: openssl rand -hex 32

# Общий ключ core и driver-service: ДОЛЖЕН совпадать с INTERNAL_API_KEY в .env driver-service
INTERNAL_API_KEY=

# Секрет служебного клиента citylogistics-core в Keycloak. Keycloak берёт его при импорте realm,
# core — для входа в Admin API. Один и тот же .env читают и Docker Compose, и core
KEYCLOAK_CORE_CLIENT_SECRET=

# Пароль администратора Keycloak (консоль http://localhost:8180, логин admin). По умолчанию admin
KEYCLOAK_ADMIN_PASSWORD=
