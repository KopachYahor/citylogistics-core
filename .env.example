# Скопируйте этот файл в .env и впишите свои значения. .env в git не попадает.
# Сгенерировать ключ (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# или: openssl rand -base64 32

# Ключ подписи JWT (base64, от 32 байт)
JWT_SECRET=

# Общий ключ core и driver-service: ДОЛЖЕН совпадать с INTERNAL_API_KEY в .env driver-service
INTERNAL_API_KEY=
